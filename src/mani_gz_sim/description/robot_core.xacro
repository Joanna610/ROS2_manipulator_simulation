<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="colors.xacro"/>

    <!-- BASE LINK -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.3" length="0.1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.3" length="0.1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.3" length="0.1"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" radius="0.3" length="0.1">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>


    <joint name="base_link_2" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/>
    </joint>
    
    <link name="chassis">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.25" length="0.5"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.25" length="0.5"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.25" length="0.5"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.5" radius="0.25" length="0.5">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

   
    
</robot>